# Build on the box from a clean published snapshot, before staging any data.
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /work
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
COPY profiler ./profiler
COPY insight ./insight
ENV PATH="/work/.venv/bin:$PATH" \
    PYTHONPATH="/work/src:/work" \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/opt/hf \
    HF_HUB_DISABLE_TELEMETRY=1
RUN python -c "from transformers import AutoModel, AutoTokenizer; from profiler.gate.embedder import E5_MODEL, E5_REVISION; AutoTokenizer.from_pretrained(E5_MODEL, revision=E5_REVISION); AutoModel.from_pretrained(E5_MODEL, revision=E5_REVISION)"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN python -c "import torch, recall.window_c, recall.eval_real; from profiler.gate.embedder import E5Embedder; assert torch.version.cuda; assert E5Embedder().encode(['passage: Erfundene Hydraulikpumpe undicht']).shape == (1, 1024)"
ENTRYPOINT []
